# Copie para .env.server e substitua todos os valores de exemplo.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-por-uma-senha-forte
JWT_SECRET=gere-com-openssl-rand-base64-48
KEYS_VIEW_CODE=20009
CORS_ORIGIN=*
TRUST_PROXY=0
# Diretório do host onde as keys ficarão persistentes.
IOSPRIVATE_DATA_DIR=/var/lib/iosprivate
