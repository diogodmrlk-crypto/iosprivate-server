{
  "name": "iosprivate-api",
  "version": "1.0.0",
  "private": false,
  "description": "API de gerenciamento de licenças IOSPRIVATE com SQLite persistente e painel administrativo.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
